# Copie este arquivo para .env e preencha os valores. Nunca envie o .env para o git.

# Servidor
PORT=3000
# Endereço público do portal, usado nos links enviados aos clientes.
#   auto = pergunta ao cloudflared o endereço atual do túnel (acompanha quando ele muda).
#   Com endereço fixo (Tailscale Funnel ou domínio próprio), coloque ele aqui,
#   ex.: https://zentry-portal.SEU-TAILNET.ts.net
#   Tailscale Funnel: tailscale funnel --bg 3000 (o script de início deixa de abrir o cloudflared).
APP_URL=auto
# Endereço de métricas do cloudflared usado pelo APP_URL=auto (o script de início usa este).
CLOUDFLARED_METRICS=127.0.0.1:20241
# Nó próprio do Tailscale para este portal (endereço https://<nome>.<tailnet>.ts.net), útil quando
#   outro portal já usa o Tailscale deste notebook. O script de início liga esse nó sozinho.
#   Primeira vez: tailscale --socket=\\.\pipe\tailscaled-<nome> up --hostname=<nome>
#   e depois:     tailscale --socket=\\.\pipe\tailscaled-<nome> funnel --bg <PORT>
# Vazio: usa o serviço normal do Tailscale.
TAILSCALE_HOSTNAME=

# E-mails da equipe Zentry, separados por vírgula. Só essas contas abrem a área interna.
# Quem criar conta pela tela de login e não estiver aqui vê "Acesso em análise".
STAFF_EMAILS=voce@exemplo.com,colega@exemplo.com
# Administradores (também precisam estar em STAFF_EMAILS): podem apagar clientes, conversas,
# documentos, vendas e consultores, e veem a página Administração (WhatsApp, backup, registro de ações).
ADMIN_EMAILS=voce@exemplo.com

# Avisos para a equipe quando um cliente escreve no portal. Vazio: todos de STAFF_EMAILS recebem por e-mail.
TEAM_NOTIFY_EMAILS=
# Números de WhatsApp da equipe que também recebem o aviso (com DDD, separados por vírgula). Opcional.
TEAM_NOTIFY_WHATSAPP=
# "off" desliga os avisos aos clientes (WhatsApp, e-mail e notificação do app) sobre respostas, status e documentos.
NOTIFY_CLIENTS=on

# Notificações do aplicativo do portal (celular e computador do cliente).
# Vazio: o servidor cria as chaves sozinho na primeira vez e guarda em .push-keys.json.
# Não troque nem perca essas chaves: todo aparelho teria que ativar as notificações de novo.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Backup diário. Uma pasta do Google Drive ou OneDrive guarda uma cópia fora do notebook.
BACKUP_DIR=backups
# "off" desliga backup e lembretes automáticos (útil numa cópia de teste do portal).
BACKGROUND_JOBS=on

# Supabase (Project Settings > API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=sua-service-role-key
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# E-mail: "off" desliga todo envio (códigos, links de acesso e avisos) e esconde "Criar login" e
# "Esqueci minha senha". A equipe ganha acesso com: npx tsx scripts/criar-acesso-equipe.ts <e-mail> <senha>
EMAIL_PROVIDER=on

# Gmail SMTP (recomendado quando não há domínio próprio de envio)
# Ative a verificação em 2 etapas e crie uma "Senha de app" na Conta Google.
GMAIL_USER=seu-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Resend (opcional, alternativa ao Gmail; exige domínio verificado para destinatários arbitrários)
# Crie a chave em https://resend.com/api-keys
RESEND_API_KEY=re_sua_chave
EMAIL_FROM=Zentry Soluções <no-reply@example.com>

# WhatsApp do link de primeiro acesso:
#   web   = não oficial e gratuito. O número da empresa é conectado pelo QR code que aparece no
#           terminal do servidor. O WhatsApp pode bloquear o número se as mensagens parecerem spam.
#   cloud = API oficial da Meta, configurada logo abaixo.
#   off   = não envia pelo WhatsApp.
WHATSAPP_PROVIDER=web
# Pasta onde a sessão fica salva. Ela vale como estar logado no número: não compartilhe nem envie ao git.
# WHATSAPP_WEB_AUTH_DIR=.whatsapp-auth

# WhatsApp Business Platform (Meta Cloud API) - link de primeiro acesso enviado pelo número corporativo
# 1. Meta Business Suite > WhatsApp Manager: registre o número e copie o "Phone number ID".
# 2. Crie um token permanente (System User com a permissão whatsapp_business_messaging).
# 3. Crie e aprove um template UTILITY em pt_BR com 2 variáveis no corpo:
#    Olá, {{1}}! Seu cadastro na Zentry Soluções foi concluído. Pelo link abaixo você cria sua senha,
#    aceita os termos de uso e acompanha o seu processo: {{2}}
#    O link vale por 7 dias e só pode ser usado uma vez.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TEMPLATE=acesso_portal
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_API_VERSION=v23.0
